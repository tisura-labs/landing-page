<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting...</title>
    <script is:inline>
        // Available languages matching [lang]/cgu.astro pattern
        const supportedLangs = ['en', 'fr', 'de', 'es'];
        
        // Get user's preferred language (first 2 chars)
        const userLang = (navigator.language || navigator.userLanguage || 'en').substring(0, 2);
        
        // Determine target language (fallback to 'en')
        const targetLang = supportedLangs.includes(userLang) ? userLang : 'en';
        
        // Redirect
        window.location.replace(`/${targetLang}/cgu`);
    </script>
    <noscript>
        <meta http-equiv="refresh" content="0;url=/fr/cgu">
    </noscript>
</head>
<body class="bg-white dark:bg-gray-900 flex items-center justify-center min-h-screen">
    <p class="text-gray-600 dark:text-gray-400 font-sans">
        Redirecting to <a href="/fr/cgu" class="text-blue-600 hover:underline">/fr/cgu</a>...
    </p>
</body>
</html>
