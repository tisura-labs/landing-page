---
import Container from "./Container.astro"

const { text } = Astro.props;
---

<div class="text-gray-600 dark:text-gray-300" id="solutions">
  <Container>
    <div class="mb-20 space-y-4 px-6 md:px-0">
      <h2 class="text-center text-2xl font-bold text-gray-800 dark:text-white md:text-4xl font-space">
        {text?.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 px-6 md:px-0">
      <a href="/dossier-certifier" class="hover:scale-105 hover:shadow-lg transition-transform duration-300">
        <div class="flex flex-col h-full p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
          <div class="flex flex-col gap-1">
            <h6 class="text-lg font-medium text-gray-700 dark:text-white font-space">{text?.dossier?.title}</h6>
            <span class="text-sm text-gray-500 dark:text-gray-400">{text?.dossier?.subtitle}</span>
          </div>
          <p class="mt-6">
            {text?.dossier?.description}
          </p>
        </div>
      </a>

      <div class="flex flex-col h-full p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex flex-col gap-1">
          <h6 class="text-lg font-medium text-gray-700 dark:text-white font-space">{text?.github?.title}</h6>
          <span class="text-sm text-gray-500 dark:text-gray-400">{text?.github?.subtitle}</span>
        </div>
        <p class="mt-6">
          {text?.github?.description}
        </p>
      </div>

      <div class="flex flex-col h-full p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none font-space">
        <div class="flex flex-col gap-1">
          <h6 class="text-lg font-medium text-gray-700 dark:text-white">{text?.identity?.title}</h6>
          <span class="text-sm text-gray-500 dark:text-gray-400">{text?.identity?.subtitle}</span>
        </div>
        <p class="mt-6">
          {text?.identity?.description}
        </p>
      </div>
    </div>

  </Container>
</div>
