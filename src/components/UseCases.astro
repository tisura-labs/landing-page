---
import Container from "./Container.astro"

const { text } = Astro.props;
---

<div class="text-gray-600 dark:text-gray-300" id="use-cases">
  <Container>
    <div class="mb-20 space-y-4 px-6 md:px-0">
      <h2 class="text-center text-2xl font-bold text-gray-800 dark:text-white md:text-4xl font-space">
        {text?.title}
      </h2>
    </div>

    <!-- Responsive: 1 col mobile, 2 cols tablet, 3 cols desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 px-6 md:px-0">

      <div class="flex flex-col h-full p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex flex-col gap-1">
          <h6 class="text-lg font-medium text-gray-700 dark:text-white font-space">{text?.rental?.title}</h6>
          <span class="text-sm text-gray-500 dark:text-gray-400">{text?.rental?.subtitle}</span>
        </div>
        <p class="mt-6">
          {text?.rental?.description}
        </p>
      </div>

      <div class="flex flex-col h-full p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none">
        <div class="flex flex-col gap-1">
          <h6 class="text-lg font-medium text-gray-700 dark:text-white font-space">{text?.loan?.title}</h6>
          <span class="text-sm text-gray-500 dark:text-gray-400">{text?.loan?.subtitle}</span>
        </div>
        <p class="mt-6">
          {text?.loan?.description}
        </p>
      </div>

      <div class="flex flex-col h-full p-8 border border-gray-100 rounded-3xl bg-white dark:bg-gray-800 dark:border-gray-700 shadow-2xl shadow-gray-600/10 dark:shadow-none font-space">
        <div class="flex flex-col gap-1">
          <h6 class="text-lg font-medium text-gray-700 dark:text-white">{text?.airdrop?.title}</h6>
          <span class="text-sm text-gray-500 dark:text-gray-400">{text?.airdrop?.subtitle}</span>
        </div>
        <p class="mt-6">
          {text?.airdrop?.description}
        </p>
      </div>

    </div>
  </Container>
</div>
