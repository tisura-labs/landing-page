---
import Container from "./Container.astro"

const { text } = Astro.props;
---

<div id="features">
  <Container>
    <h2 class="text-center text-2xl font-bold text-gray-800 dark:text-white md:text-4xl">
      {text?.title}
    </h2>

    <div
      class="mt-16 grid divide-x divide-y divide-gray-100 dark:divide-gray-700 overflow-hidden rounded-3xl border border-gray-100 text-gray-600 dark:border-gray-700 sm:grid-cols-2 lg:grid-cols-4 lg:divide-y-0 xl:grid-cols-4"
    >
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <img
            src="/images/certified.png"
            class="w-12"
            width="512"
            height="512"
            alt="certified stamp"
          />

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
            {text?.origin?.title}
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
            {text?.origin?.description}
            </p>
          </div>
        </div>
      </div>
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <img
            src="/images/magnifier.png"
            class="w-12"
            width="512"
            height="512"
            alt="magnifier glass"
          />

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
            {text?.fraud?.title}
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
            {text?.fraud?.description}
            </p>
          </div>
        </div>
      </div>
      <div class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10">
        <div class="relative space-y-8 py-12 p-8">
          <img
            src="/images/globe.png"
            class="w-12"
            width="512"
            height="512"
            alt="globe"
          />

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
            {text?.permissionless?.title}
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
            {text?.permissionless?.description}
            </p>
          </div>
        </div>
      </div>
      <div
        class="group relative bg-white dark:bg-gray-800 transition hover:z-[1] hover:shadow-2xl hover:shadow-gray-600/10"
      >
        <div
          class="relative space-y-8 py-12 p-8 transition duration-300 group-hover:bg-white dark:group-hover:bg-gray-800"
        >
          <img
            src="/images/incognito.png"
            class="w-12"
            width="512"
            height="512"
            alt="incognito"
          />

          <div class="space-y-2">
            <h5
              class="text-xl font-semibold text-gray-700 dark:text-white transition group-hover:text-secondary"
            >
            {text?.privacy?.title}
            </h5>
            <p class="text-gray-600 dark:text-gray-300">
            {text?.privacy?.description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</div>
